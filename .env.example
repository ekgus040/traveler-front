# ── 클라이언트 번들에 주입되는 값 (VITE_ 접두사) ────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_MOCK_MODE=false
# 네이버 지도 JS SDK (ncpKeyId). 아래 NAVER_CLIENT_ID 와 다른 키다.
VITE_NAVER_MAP_CLIENT_ID=your_naver_map_client_id

# ── dev 서버 프록시 전용 (vite.config.ts, 번들에 포함되지 않음) ─────────
# 네이버 클라우드 Directions API
NAVER_CLIENT_ID=your_naver_cloud_client_id
NAVER_CLIENT_SECRET=your_naver_cloud_client_secret
# 한국관광공사 TourAPI. 비워두면 ../mobility_rag/.env 의 같은 이름 값을 사용한다.
KORWITHSERVICE_API_KEY=
